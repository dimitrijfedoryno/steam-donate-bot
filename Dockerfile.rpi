FROM node:20-slim

RUN apt-get update -qq && apt-get install -y -qq git && rm -rf /var/lib/apt/lists/*

ARG REPO_URL=https://github.com/TVA-ZA/steam-stream-donate-bot.git
ARG REPO_BRANCH=main

WORKDIR /app

RUN git clone --depth 1 -b ${REPO_BRANCH} ${REPO_URL} .

RUN npm ci --omit=dev && \
    cd admin && npm ci && npm run build && cd .. && \
    mkdir -p logs

EXPOSE 3000

CMD ["node", "src/gui.js"]
